# Dependencies
node_modules/
web/node_modules/

# Next.js
web/.next/
web/out/
*.tsbuildinfo
next-env.d.ts

# Data (local state — regenerated by the seeder; user CVs are personal).
# Keep the folder structure via .gitkeep, ignore everything the engine writes.
data/config/*.json
data/state/*.json
data/log/*.jsonl
data/queue/*.jsonl
data/log/screens/*
data/cv/*
data/.cycle-lock
*.log
.DS_Store

!data/.gitkeep
!data/config/.gitkeep
!data/state/.gitkeep
!data/log/.gitkeep
!data/queue/.gitkeep
!data/cv/.gitkeep
!data/log/screens/.gitkeep
